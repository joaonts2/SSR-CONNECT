{
  "name": "Student",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "turma": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "student_login": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "enrollment": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "turma",
    "student_login",
    "password_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}