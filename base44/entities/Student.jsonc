{
  "name": "Student",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "turma": {
      "type": "string"
    },
    "login": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "enrollment": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "turma",
    "login",
    "password_hash"
  ]
}