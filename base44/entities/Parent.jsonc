{
  "name": "Parent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "email",
    "password_hash"
  ]
}