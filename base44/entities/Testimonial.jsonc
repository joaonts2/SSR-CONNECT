{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Aluno",
        "Pai/M\u00e3e",
        "Ex-Aluno",
        "Professor"
      ],
      "default": "Aluno"
    },
    "content": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5
    },
    "avatar_url": {
      "type": "string"
    },
    "is_approved": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "content"
  ]
}