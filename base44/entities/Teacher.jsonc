{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "disciplines": {
      "type": "string"
    },
    "turmas": {
      "type": "string"
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "email",
    "password_hash"
  ]
}