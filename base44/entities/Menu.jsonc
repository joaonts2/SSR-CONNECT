{
  "name": "Menu",
  "type": "object",
  "properties": {
    "weekday": {
      "type": "string",
      "enum": [
        "Segunda",
        "Ter\u00e7a",
        "Quarta",
        "Quinta",
        "Sexta",
        "S\u00e1bado",
        "Domingo"
      ],
      "default": "Segunda"
    },
    "lanche_manha": {
      "type": "string"
    },
    "almoco": {
      "type": "string"
    },
    "lanche_tarde": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "weekday"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}