{
  "name": "Notice",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal"
    },
    "audience": {
      "type": "string",
      "enum": [
        "Todos",
        "Alunos",
        "Pais",
        "Professores"
      ],
      "default": "Todos"
    },
    "turma": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "content"
  ]
}